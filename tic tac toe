#include<stdio.h>
char board[3][3]={
        {'1','2','3'},
        {'4','5','6'},
        {'7','8','9'},
    };
void printboard(){
    int i,j,n;
    
    for(i=0;i<3;i++)
    {
        printf(" %c | %c | %c\n",board[i][0],board[i][1],board[i][2]);
        if(i!=2)
        {
            printf("---|---|---\n");
        }
    }
}
int wincheck(){
    int i,j;
    for(i=0;i<3;i++){
        if(board[i][0] == board[i][1] && board[i][1] == board[i][2]){
        return 1;
        }
    }
    for(i=0;i<3;i++){
        if(board[0][i] == board[1][i] && board[1][i] == board[2][i]){
        return 1;
        }
    }
    
        if(board[0][0] == board[1][1] && board[1][1] == board[2][2]){
        return 1;
        }
        if(board[2][0] == board[1][1] && board[1][1] == board[0][2]){
        return 1;
        }
        int count=0;
        for(i=0;i<3;i++){
        for(j=0;j<3;j++){
            if(board[i][j] != 'X' && board[i][j] != 'O'){
                count++;
            }
        }
        }
        if(count == 0){
            return 2; //draw
        }
        return 0;
    
}

int main(){
    
    int row,column,move,gs;
    int player = 1;
    while(1){
        printboard();
        printf("Player %d move: ",player);
        scanf("%d",&move);
        row = (move-1)/3;
        column = (move-1)%3;
        if(board[row][column] != 'X' && board[row][column] != 'O'){
            if(player == 1){
                board[row][column] = 'X';
            }
            else{
                board[row][column] = 'O';
            }
        }
            else{
                printf("The box is already filled!\n");
                continue;
            }
            gs = wincheck();
            if(gs == 1){
                printboard();
                printf("Player %d is the Winner!\n",player);
                break;
            }
    
            if(gs==2){
                printboard();
                printf("Draw\n");
                break;
            }
            player = (player % 2) + 1;
        }

     
    return 0;
}
